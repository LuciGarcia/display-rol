{
  "name": "floorplan-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:domain": "tsx --test src/**/*.test.ts",
    "test": "npm run test:domain",
    "ai:smoke": "tsx --env-file=.env.local scripts/ai-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/db-migrate.ts",
    "test:integration": "tsx --env-file=.env.local --test \"src/**/*.integration.ts\""
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.73",
    "@ai-sdk/openai": "^4.0.68",
    "@google/generative-ai": "^0.24.1",
    "ai": "^7.0.103",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.5",
    "pixi.js": "^8.21.0",
    "postgres": "^3.4.9",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
