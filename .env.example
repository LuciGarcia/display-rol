# .env.example — copiar a .env.local. Nunca poner valores reales acá.
GOOGLE_GENERATIVE_AI_API_KEY=
# Opcionales:
# AI_PROVIDER=google
# AI_MODEL=
# AI_TIMEOUT_MS=30000

# Base de datos de la aplicación (PostgreSQL). Copiá este archivo a .env.local y completá tus datos.
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/display_rol

# Solo para tests de integración. Debe ser una base DISTINTA y su nombre debe contener "test":
# el test vacía la tabla games antes de cada prueba.
TEST_DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/display_rol_test

# Tiempo real (Pusher). Sin estas variables la app funciona igual, solo sin difusión en vivo.
# PUSHER_APP_ID y PUSHER_SECRET son SOLO de servidor: nunca con prefijo NEXT_PUBLIC_.
PUSHER_APP_ID=
PUSHER_SECRET=
# La clave y el cluster son públicos por diseño (los usa el navegador).
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Autenticación Master/Player (SOLO servidor; nunca con prefijo NEXT_PUBLIC_).
# AUTH_SECRET firma las sesiones (mínimo 32 caracteres aleatorios). MASTER_KEY es la clave que
# escribe el Master para entrar (mínimo 12 caracteres). Sin ellas nadie puede escribir (falla cerrado).
AUTH_SECRET=
MASTER_KEY=