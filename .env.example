# .env.example — copiar a .env.local. Nunca poner valores reales acá.
GOOGLE_GENERATIVE_AI_API_KEY=
# Opcionales:
# AI_PROVIDER=google
# AI_MODEL=
# AI_TIMEOUT_MS=30000

# Base de datos de la aplicación (PostgreSQL). Copiá este archivo a .env.local y completá tus datos.
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/display_rol

# Solo para tests de integración. Debe ser una base DISTINTA y su nombre debe contener "test":
# el test vacía la tabla games antes de cada prueba.
TEST_DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/display_rol_test